CARD_LABEL = {
    'Size': 'Sizes', 'Width': 'Widths', 'Depth': 'Depths', 'Height': 'Heights',
    'Seats': 'Seats', 'Hooks': 'Hooks', 'Locking': 'Locking Options', 'Base': 'Bases',
    'Power Data Module': 'Power Module', 'Pedestal Depth': 'Pedestal Depths',
    'Drawers': 'Drawers', 'Shelves': 'Shelves', 'Doors': 'Doors', 'Edge': 'Edge Options',
    'Design': 'Designs', 'Screen': 'Screen Options', 'Castors': 'Castor Options',
    'Material': 'Materials', 'Range': 'Ranges', 'Finish': 'Finishes', 'Shape': 'Shapes',
    'Frame Colour': 'Frame Colours', 'Hand': 'Handing', 'Leg Type': 'Leg Types',
}
CARD_DOT_LIMIT = 9        # swatch/image options draw dots; nine fit on a tile
CARD_TEXT_BUDGET = 34     # text options print a comma list, so characters run out

# ---------------------------------------------------------------------- pricing

# cost = this share of the supplier RRP, to the penny
COST_OF_RRP = Decimal('0.37')
# selling price = cost plus this margin, rounded UP to the whole pound
PRICE_OF_COST = Decimal('1.06')
TAX_CLASS_ID = '2de2dd0e-389e-42fe-8b29-1f6bc5bd86ce'

# ----------------------------------------------------------------------- media

# Supplier photos land in B2 at media/dynamic/<basename> when they are converted.
# The import points shp_product_media at the CANONICAL per-product path from the
# start - media/shop/<master category trail>/<listing>/<basename>, the same place
# modules/shop/lib/media/product-media.ts files an editor upload - and
# file_media.py copies the blobs there and re-points their Media rows to match.
MEDIA_HOST = 'https://media.deskwell.co.uk/'
DYNAMIC_PREFIX = 'media/dynamic/'          # the landing folder the photos start in
B2_BUCKET = 'Deskwell-Office-Furniture'    # for file_media.py's rclone steps


def MEDIA_BASENAME(sku, n):
    """How converted supplier photos are named, in dynamic and canonical alike."""
    return f'{sku.lower()}_{n}.webp'


# -------------------------------------------------------------------- categories

# Leaves to create because nothing on the site fits. (name, slug, parent slug, blurb)
NEW_CATEGORIES = [
    ('Safes & security', 'safes-security', 'office-storage',
     'Fire and security safes, deposit safes, cash boxes and key cabinets.'),
    ('Storage accessories', 'storage-accessories', 'office-storage',
     'Shelves, filing frames, handles and castors for office storage units.'),
]


def _has(name, *words):
    low = name.lower()
    return any(w.lower() in low for w in words)


def categorise(sheet_category, listing_name):
    """(master category slug, [additional slugs]) - leaf categories only.

    One supplier category often spans several of the site's, so refine on words in the
    listing name. Check the live tree in the analyse report before trusting this.
    """
    cat, name = sheet_category, listing_name
    if cat in ('Acoustic Baffles', 'Acoustic Screens', 'Acoustic Tiles'):
        return 'acoustic-panels-pods', []
    if cat == 'Bistro Tables':
        if _has(name, 'Poseur'):
            return 'poseur-high-tables', ['caf-bistro-tables']
        if _has(name, 'Coffee'):
            return 'coffee-occasional-tables', ['caf-bistro-tables']
        if _has(name, 'Boardroom'):
            return 'meeting-boardroom-tables', []
        return 'caf-bistro-tables', []
    if cat == 'Boardroom and Conference Tables':
        if _has(name, 'Poseur'):
            return 'poseur-high-tables', ['meeting-boardroom-tables']
        if _has(name, 'Coffee'):
            return 'coffee-occasional-tables', []
        if _has(name, 'Extension Kit'):
            return 'conference-tables-modular', ['meeting-boardroom-tables']
        return 'meeting-boardroom-tables', ['conference-tables-modular'] if _has(name, 'Volta') else []
    if cat == 'Café & Bistro':
        return ('coffee-occasional-tables', ['caf-bistro-tables']) if _has(name, 'Coffee') \
            else ('caf-bistro-tables', [])
    if cat == 'Coat Stands':
        return 'coat-umbrella-stands', []
    if cat == 'Corner Desks':
        return 'corner-wave-desks', []
    if cat == 'Desk Accessories':
        if _has(name, 'Monitor Arm'):
            return 'monitor-arms-mounts', []
        if _has(name, 'PC Holder'):
            return 'cpu-holders', []
        if _has(name, 'Cable', 'Spine', 'Tray', 'Basket', 'Infill'):
            return 'cable-management', []
        if _has(name, 'Screen', 'Clamp', 'Modesty'):
            return 'desk-screens-privacy-dividers', []
        if _has(name, 'Linking', 'Bracket', 'Piste Foot', 'Leg Frame'):
            return 'desk-extensions-returns', []
        return 'desk-organisers', []
    if cat == 'Desks':
        return ('bench-desks-workstations', []) if _has(name, 'Bench', 'B2B') \
            else ('rectangular-desks', [])
    if cat in ('Desktop Screens', 'Protection Screen'):
        return 'desk-screens-privacy-dividers', []
    if cat == 'Electrical Accessories':
        return 'power-modules-desktop-sockets', []
    if cat == 'Floor Screens':
        return 'floor-standing-partition-screens', []
    if cat == 'Folding Tables':
        return 'folding-flip-top-tables', []
    if cat == 'Height Adjustable Desks':
        return ('bench-desks-workstations', ['sit-stand-desks-electric']) if _has(name, 'Bench', 'B2B') \
            else ('sit-stand-desks-electric', [])
    if cat == 'Pedestals':
        return 'pedestals', []
    if cat == 'Security':
        return 'safes-security', []
    if cat == 'Shaped Tables':
        return ('training-tables', ['breakout-collaboration-tables']) if _has(name, 'Trapezium', 'Semi-Circle') \
            else ('breakout-collaboration-tables', ['meeting-boardroom-tables'])
    if cat == 'Storage':
        if _has(name, 'Filing Frame'):
            return 'storage-accessories', []
        if _has(name, 'Filing Cabinet'):
            return 'filing-cabinets-vertical', []
        if _has(name, 'Tambour'):
            return 'tambour-roller-door-cupboards', []
        if _has(name, 'Locker'):
            return 'lockers', []
        if _has(name, 'Bookcase'):
            return 'bookcases-shelving', ['mobile-storage-caddies'] if _has(name, 'Mobile') else []
        if _has(name, 'Credenza'):
            return 'credenzas-sideboards', []
        if _has(name, 'Side Filer'):
            return 'side-lateral-filing', []
        return 'cupboards', ['mobile-storage-caddies'] if _has(name, 'Mobile') else []
    if cat == 'Storage Accessories':
        return 'storage-accessories', []
    if cat == 'Tables':
        return ('breakout-collaboration-tables', ['training-tables']) if _has(name, 'Square') \
            else ('training-tables', ['meeting-boardroom-tables'])
    if cat == 'Visual Communication':
        return ('sign-wayfinding', []) if _has(name, 'Snap Frame') else ('whiteboards-noticeboards', [])
    if cat == 'Workstations':
        return ('corner-wave-desks', []) if _has(name, 'Crescent') else ('rectangular-desks', [])
    raise SystemExit(f'no category mapping for {cat!r} (listing {listing_name!r}) - '
                     f'add a rule to categorise() in import_config.py')
