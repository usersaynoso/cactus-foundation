    'Width':             ('Width', 'width', 'PILL', 'DROPDOWN'),
    'Depth':             ('Depth', 'depth', 'PILL', 'DROPDOWN'),
    'Height':            ('Height', 'height', 'PILL', 'DROPDOWN'),
    'Seats':             ('Seats', 'seats', 'PILL', 'DROPDOWN'),
    'Hooks':             ('Hooks', 'hooks', 'PILL', 'DROPDOWN'),
    'Locking':           ('Locking', 'locking', 'PILL', 'DROPDOWN'),
    'Base':              ('Base', 'base', 'PILL', 'DROPDOWN'),
    'Power Data Module': ('Power Data Module', 'power-data-module', 'IMAGE', 'IMAGE'),
    'Pedestal Depth':    ('Pedestal Depth', 'pedestal-depth', 'PILL', 'DROPDOWN'),
    'Drawers':           ('Drawers', 'drawers', 'PILL', 'DROPDOWN'),
    'Shelves':           ('Shelves', 'shelves', 'PILL', 'DROPDOWN'),
    'Doors':             ('Doors', 'doors', 'PILL', 'DROPDOWN'),
    'Edge':              ('Edge', 'edge', 'PILL', 'DROPDOWN'),
    'Design':            ('Design', 'design', 'PILL', 'DROPDOWN'),
    'Screen':            ('Screen', 'screen', 'PILL', 'DROPDOWN'),
    'Castors':           ('Castors', 'castors', 'PILL', 'DROPDOWN'),
    'Material':          ('Material', 'material', 'PILL', 'DROPDOWN'),
    'Range':             ('Range', 'range', 'PILL', 'DROPDOWN'),
    'Finish':            ('Finish', 'finish', 'IMAGE', 'IMAGE'),
    'Shape':             ('Shape', 'shape', 'PILL', 'DROPDOWN'),
    'Frame Colour':      ('Frame Colour', 'frame-colour', 'SWATCH', 'SWATCH'),
    'Hand':              ('Hand', 'hand', 'PILL', 'DROPDOWN'),
    'Leg Type':          ('Leg Type', 'leg-type', 'PILL', 'DROPDOWN'),
}
ATTR_NAME = {'base': 'Base', 'catalog': 'Catalog', 'range': 'Range', 'castors': 'Castors', 'design': 'Design', 'doors': 'Doors',
             'drawers': 'Drawers', 'edge': 'Edge', 'frame-colour': 'Frame Colour',
             'hand': 'Hand', 'hooks': 'Hooks', 'leg-type': 'Leg Type', 'locking': 'Locking',
             'material': 'Material', 'pedestal-depth': 'Pedestal Depth', 'screen': 'Screen',
             'shape': 'Shape', 'shelves': 'Shelves'}
OPTION_SOURCE_PROVIDER = 'product-attributes'

# Attributes assigned to every listing as a per-variation column, hidden from the public
# filter grid. They are not options - nothing here affects how variations are bundled.
# Assigning them is what puts the column on the listing's Variations tab, and so in the
# catalogue sheet, for the owner to fill in afterwards. Every listing that predates the
# July 2026 import carries exactly these two, with the same pair of flags.
VARIATION_COLUMN_ATTRIBUTES = ['catalog', 'range']

# Hex swatches for values the shared library has no image for. A value with neither
