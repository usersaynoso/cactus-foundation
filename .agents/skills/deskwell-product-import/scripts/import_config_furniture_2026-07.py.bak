"""Per-import rules for the Deskwell product import. EDIT THIS, not import_lib.py.

The values here worked for the July 2026 supplier "Furniture Dataset" import. A new
supplier phrases things its own way, so expect to revise:

  COLUMNS          - if the sheet's column headings differ
  GROUP_LIFTS      - tokens in a group name that are a choice, not a product
  NAME_LIFTS       - attributes stated only in the product name
  MERGE_PHRASES    - version words ("Slimline", "Volta") that merge groups
  categorise()     - the supplier's categories onto the site's leaf categories
  NEW_CATEGORIES   - leaves to create, only where nothing fits

Read references/catalogue_conventions.md before changing the ordering lists: they encode
why a buyer sees "Cross Base" rather than "49.5cm".
"""
import re
from decimal import Decimal

# ----------------------------------------------------------------- sheet shape

HEADER_ROW = 3          # 0-indexed row holding the column headings

# logical name -> the sheet's column heading
COLUMNS = {
    'sku': 'SKU', 'name': 'Product Name', 'group': 'Product Group',
    'category': 'Category', 'brand': 'Brand', 'rrp': 'RRP',
    'weight': 'Weight (kg)', 'barcode': 'EAN Barcode',
    'description_html': 'Product Group Body HTML',
    'marketing_text': 'Marketing Text', 'features': 'Product Features',
    'width': 'Width', 'depth': 'Depth', 'height': 'Height',
    'top_width': 'Top Width', 'top_depth': 'Top Depth',
    'finish': 'Finish', 'colour': 'Colour', 'frame_colour': 'Frame Colour',
    'leg_type': 'Leg Type', 'shape': 'Shape', 'top_shape': 'Top Shape',
    'material': 'Material', 'range': 'Range',
    'drawer_qty': 'Drawer Qty', 'shelf_qty': 'Shelf Qty',
}

# Supplier typos, normalised on the way in. A misspelt group name silently defeats
# duplicate detection: "Straigh" once hid a desk range that was already on the site.
TYPOS = [(re.compile(r'\bStraigh\b'), 'Straight'),
         (re.compile(r'\bMechancical\b'), 'Mechanical')]

# ------------------------------------------------------------ what becomes an axis

# axis -> the columns to read it from, first non-empty wins. A desk's marketing width is
# its top width; the overall Width includes the pedestal.
COLUMN_AXES = [
    ('Width', ['top_width', 'width']),
    ('Depth', ['top_depth', 'depth']),
    ('Height', ['height']),
    ('Finish', ['finish', 'colour']),
    ('Frame Colour', ['frame_colour']),
    ('Leg Type', ['leg_type']),
    ('Range', ['range']),
    ('Material', ['material']),
    ('Shape', ['top_shape', 'shape']),
]
# axis -> (column, label suffix) for a count
COUNT_AXES = [('Drawers', 'drawer_qty', ' Drawer'), ('Shelves', 'shelf_qty', ' Shelf')]

DIMENSION_AXES = {'Size', 'Width', 'Depth', 'Height', 'Pedestal Depth'}
NUMERIC_AXES = DIMENSION_AXES | {'Seats', 'Hooks', 'Drawers', 'Shelves', 'Doors'}

# ------------------------------------------------------------------ name wrangling

# Wording the spec columns already carry. Always dropped: it clutters a listing name and
# keeps otherwise-identical groups apart.
NOISE_PHRASES = [re.compile(p, re.I) for p in (
    r'\s+White Top Natural Wood Edge\b', r'\s+Natural Wood Edge\b', r'\s+White Top\b',
    r'\s+Office(?=\s+(?:Bench|Desk|Table|Chair)\b)', r'\s+\(Available in \d+ Sizes\)',
)]

# Words naming a version of the same product rather than a different product. Dropped
# only when doing so merges groups, because the difference then lives on an option:
# "Slimline" is the 60cm-deep desk, "Volta" is the one with the pop-up power module.
# Each pattern needs leading whitespace so a name that *starts* with the word (the
# standalone Volta power accessories) is left alone.
MERGE_PHRASES = [re.compile(p, re.I) for p in (r'\s+Slimline\b', r'\s+Volta\b')]

# Tokens lifted out of a group name and recorded as an option value. Order matters: an
# earlier rule wins, and each match is cut out of the stem.
GROUP_LIFTS = [
    ('Height',       re.compile(r'\s*[-–]\s*(\d{3,4})\s*mm High\b', re.I), lambda m: f'{m.group(1)}mm'),
    ('Height',       re.compile(r'\s+(\d{3,4})\s*mm High\b', re.I),        lambda m: f'{m.group(1)}mm'),
    ('Leg Type',     re.compile(r'\s+(Cable Managed|Cantilever|Panel End)\s+Leg\b', re.I),
                     lambda m: m.group(1).title()),
    ('Frame Colour', re.compile(r'\s+(Black|Silver|White|Chrome|Graphite|Brushed Aluminium)\s+(?=Post Leg\b)', re.I),
                     lambda m: m.group(1).title()),
    ('Leg Type',     re.compile(r'\s+(?:With\s+)?(Post|Box Frame|Arrowhead)\s+Leg\b', re.I),
                     lambda m: m.group(1).title() + ' Leg'),
    ('Base',         re.compile(r'\s+With\s+(Cross Base|Disc Base)\b', re.I), lambda m: m.group(1).title()),
    ('Power Data Module', re.compile(r'\s+With\s+(?:(Black|White)\s+)?Pop-up Power Module\b', re.I),
                     lambda m: m.group(1).title() if m.group(1) else 'Pop-up Power Module'),
    ('Frame Colour', re.compile(r'\s*[-–]?\s*(Black|Silver|White|Chrome|Graphite)\s+Leg(\s+Frame)?\b', re.I),
                     lambda m: m.group(1).title()),
    ('Frame Colour', re.compile(r'\s+With\s+(Black|Silver|White|Chrome|Graphite)\s+Leg\s+Frame\b', re.I),
                     lambda m: m.group(1).title()),
    ('Frame Colour', re.compile(r'\s+(Black|Silver|White|Chrome|Graphite)\s+Frame\b', re.I),
                     lambda m: m.group(1).title()),
    ('Width',        re.compile(r'\s+(\d{3,4})\s*mm\b', re.I), lambda m: f'{m.group(1)}mm'),
    ('Hand',         re.compile(r'\s+(Left|Right)\b', re.I), lambda m: m.group(1).title()),
    ('Leg Type',     re.compile(r'\s+(Cable Managed|Cantilever|Panel End)\b', re.I),
                     lambda m: m.group(1).title()),
    ('Seats',        re.compile(r'\s*[-–]?\s*(\d)\s+Person\b', re.I), lambda m: f'{m.group(1)} Person'),
    ('Finish',       re.compile(r'\s+(Black|Silver|White|Beech|Oak|Maple|Walnut|Grey Oak)$', re.I),
                     lambda m: m.group(1).title()),
]

# Attributes the supplier only ever states in the product name.
# (axis, pattern, formatter, value when the name never mentions it)
NAME_LIFTS = [
    # A bench desk's Width column is the whole run (3620mm for six people), so the
    # per-desk size the name states is what the buyer actually chooses.
    ('Width',          re.compile(r'\b(\d{3,4})\s*x\s*\d{3,4}\s*mm\b', re.I), lambda m: f'{m.group(1)}mm', None),
    ('Depth',          re.compile(r'\b\d{3,4}\s*x\s*(\d{3,4})\s*mm\b', re.I), lambda m: f'{m.group(1)}mm', None),
    ('Seats',          re.compile(r'\b(\d)\s+Person\b', re.I),                lambda m: f'{m.group(1)} Person', None),
    ('Pedestal Depth', re.compile(r'\b(\d{3,4})\s+Deep\b', re.I),             lambda m: f'{m.group(1)}mm Deep', None),
    ('Doors',          re.compile(r'\bwith\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)\s+Doors\b'),
                                                                              lambda m: f'{m.group(1)} Doors', None),
    ('Doors',          re.compile(r'\b(\d)\s+Door\b', re.I),                  lambda m: f'{m.group(1)} Door', None),
    ('Screen',         re.compile(r'\bwith\s+((?:Black|White|Silver|Grey)\s+Straight Screen)\b', re.I),
                                                                              lambda m: m.group(1).title(), 'No Screen'),
    ('Castors',        re.compile(r'\bWith Castors\b', re.I),                 lambda m: 'With Castors', 'No Castors'),
    ('Edge',           re.compile(r'\b(Bevelled|Square)\s+Edge\b', re.I),     lambda m: f'{m.group(1).title()} Edge', None),
    # Safes and key cabinets: the lock and the hook count are the real choices, and the
    # maker's own "Size 3" beats the millimetres it works out to.
    ('Locking',        re.compile(r'\bwith\s+(Net Code Electronic|Mechan\w*\s+Combination|Electronic Code|Electronic|Fingerprint|Key)\s+Lock\b', re.I),
                       lambda m: re.sub(r'\s+', ' ', m.group(1)).title() + ' Lock', None),
    ('Hooks',          re.compile(r'\b(\d+)\s+Hook\b', re.I),                 lambda m: f'{m.group(1)} Hook', None),
    ('Size',           re.compile(r'\bSize\s+(\d)\b'),                        lambda m: f'Size {m.group(1)}', None),
]

# What a merged group that never mentions a lifted attribute actually offers. Without
# this the axis looks non-varying, gets dropped, and a measurement stands in for it - a
# buyer sees "49.5cm" where they should see "Cross Base".
ABSENT_LABEL = {'Power Data Module': 'None', 'Base': 'Standard Base', 'Leg Type': 'Leg Frame'}

# A chosen axis must never show a blank value on the storefront.
BLANK_LABEL = {'Doors': 'No Doors', 'Shelves': 'No Shelves', 'Drawers': 'No Drawers',
               'Locking': 'Key Lock', 'Castors': 'No Castors', 'Screen': 'No Screen'}

MERGE_KEY_SUBSTITUTIONS = [('ext kit', 'extension kit'), ('back-to-back', 'b2b'),
                           ('back to back', 'b2b')]
MERGE_KEY_STOPWORDS = {'office', 'the', 'a'}

# ------------------------------------------------------------------- option order

MAX_OPTIONS = 4

# Axes are considered in this order until every SKU is uniquely identified. A thing a
# buyer picks (base type, seat count, leg type) comes before a measurement that merely
# follows from it, so the measurement drops out as redundant instead of replacing it.
KEEP_ORDER = ['Size', 'Seats', 'Hooks', 'Locking', 'Width', 'Depth', 'Power Data Module',
              'Base', 'Leg Type', 'Pedestal Depth', 'Drawers', 'Shelves', 'Doors', 'Edge',
              'Design', 'Screen', 'Castors', 'Material', 'Range', 'Height', 'Finish',
              'Shape', 'Frame Colour', 'Hand']

# Which axis a five-option listing peels off into separate listings. Undoing a name
# merge (leg type, base, hand) beats breaking up a choice a buyer expects to make, which
# is why Finish is last.
SPLIT_PREFERENCE = ['Leg Type', 'Base', 'Power Data Module', 'Hand', 'Shape', 'Frame Colour',
                    'Range', 'Height', 'Castors', 'Screen', 'Doors', 'Material', 'Edge',
                    'Design', 'Seats', 'Pedestal Depth', 'Shelves', 'Drawers', 'Locking',
                    'Hooks', 'Width', 'Size', 'Finish']

# The order options appear in on the product page.
DISPLAY_ORDER = ['Size', 'Width', 'Depth', 'Height', 'Seats', 'Hooks', 'Power Data Module',
                 'Shape', 'Hand', 'Base', 'Design', 'Edge', 'Range', 'Material',
                 'Pedestal Depth', 'Drawers', 'Shelves', 'Doors', 'Locking', 'Screen',
                 'Castors', 'Finish', 'Frame Colour', 'Leg Type']

# How a split value reads when appended to a listing name.
SPLIT_NAME = {
    'Leg Type': lambda v: f'With {v}' if v.lower().startswith('leg')
                else (v if v.lower().endswith('leg') else f'{v} Leg'),
    'Power Data Module': lambda v: '' if v == 'None' else f'With {v}',
    'Hand': lambda v: f'{v} Hand',
    'Frame Colour': lambda v: f'{v} Frame',
    'Height': lambda v: f'{v} High',
    'Base': lambda v: f'With {v}',
    'Castors': lambda v: v,
    'Screen': lambda v: '' if v == 'No Screen' else f'With {v}',
}

# ------------------------------------------------------- options -> attributes

