{
  "name": "cactus",
  "version": "0.5.1567",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-all.mjs && next dev --webpack",
    "dev:warm": "bash scripts/dev-warm.sh",
    "build": "node scripts/prebuild.mjs && node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/generate-all.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backup-roundtrip": "RUN_BACKUP_ROUNDTRIP=1 vitest run lib/backup/roundtrip.test.ts",
    "test:shop-sql": "vitest run lib/backup/shop-sql.test.ts",
    "test:ledger-guards": "RUN_LEDGER_GUARDS=1 vitest run modules/uk-bookkeeping/lib/ledger-guards.live.test.ts modules/uk-bookkeeping/lib/ledger-projection.live.test.ts modules/uk-bookkeeping/lib/import-roundtrip.live.test.ts modules/uk-bookkeeping/lib/category-accounts.live.test.ts modules/uk-bookkeeping/lib/documents.live.test.ts modules/uk-bookkeeping/lib/vat-boxes.live.test.ts modules/shop/lib/db/refund-netting.live.test.ts modules/shop/lib/db/order-access.live.test.ts modules/shop/lib/db/order-requests.live.test.ts modules/shop/lib/stranded-payments.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:po-sql": "RUN_PO_SQL=1 vitest run modules/purchase-orders/lib/sql-guards.live.test.ts --testTimeout 300000 --no-file-parallelism",
    "test:inbox-guards": "RUN_INBOX_REOPEN_GUARDS=1 RUN_INBOX_INTERNAL_GUARDS=1 RUN_INBOX_ADOPTION_GUARDS=1 vitest run modules/unified-inbox/lib/reopen-on-reply.live.test.ts modules/unified-inbox/lib/internal-threads.live.test.ts modules/unified-inbox/lib/folder-adoption.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-discussions": "RUN_INBOX_DISCUSSIONS=1 vitest run modules/unified-inbox/lib/discussions.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-mentions": "RUN_INBOX_MENTION_GUARDS=1 vitest run modules/unified-inbox/lib/mentions.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-addressed": "RUN_INBOX_ADDRESSED=1 vitest run modules/unified-inbox/lib/addressed-channels.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-own-desk": "RUN_INBOX_OWN_DESK=1 vitest run modules/unified-inbox/lib/own-desk.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-search-sql": "RUN_INBOX_SEARCH_SQL=1 vitest run modules/unified-inbox/lib/search-sql.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-arrival": "RUN_INBOX_ARRIVAL=1 vitest run modules/unified-inbox/lib/arrival-order.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-contacts": "RUN_INBOX_CONTACTS=1 vitest run modules/unified-inbox/lib/contacts.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-campaign-sql": "RUN_INBOX_CAMPAIGN_SQL=1 vitest run modules/unified-inbox/lib/campaign-sql.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-quote": "RUN_INBOX_QUOTE=1 vitest run modules/unified-inbox/lib/quoted-message.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-clicks": "RUN_INBOX_CLICKS=1 vitest run modules/unified-inbox/lib/click-tracking.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-module-mail": "RUN_INBOX_MODULE_MAIL=1 vitest run modules/unified-inbox/lib/module-mail.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-inline": "RUN_INBOX_INLINE_GUARDS=1 vitest run modules/unified-inbox/lib/inline-images.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:filters-sql": "RUN_FILTERS_SQL=1 vitest run modules/filters-for-shop/lib/matching-sql.live.test.ts --testTimeout 300000 --no-file-parallelism",
    "test:discovery-sql": "RUN_DISCOVERY_SQL=1 vitest run modules/product-discovery-tool/lib/discovery-sql.live.test.ts --testTimeout 300000 --no-file-parallelism",
    "check:module-pins": "CHECK_MODULE_PINS=1 vitest run lib/modules/pin-check.live.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "echo 'Use prisma migrate dev instead of db push \u2014 see AGENTS.md' && exit 1",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "sync-wiki": "node scripts/sync-wiki.mjs",
    "fonts:refresh": "node scripts/fetch-google-fonts.mjs",
    "test:inbox-merge": "RUN_INBOX_MERGE_GUARDS=1 vitest run modules/unified-inbox/lib/thread-merge.live.test.ts --testTimeout 120000 --no-file-parallelism",
    "test:inbox-campaign-threads": "RUN_INBOX_CAMPAIGN_THREADS=1 vitest run modules/unified-inbox/lib/campaign-threads.live.test.ts --testTimeout 120000 --no-file-parallelism"
  },
