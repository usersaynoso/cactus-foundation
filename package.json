    "@prisma/client": "^6.0.0",
    "@puckeditor/core": "^0.22.0",
    "@simplewebauthn/browser": "^13.0.0",
    "@simplewebauthn/server": "^13.0.0",
    "@sparticuz/chromium-min": "149.0.0",
    "@supabase/storage-js": "^2.108.2",
    "@types/aos": "^3.0.8",
    "@vercel/blob": "^2.4.1",
    "@vercel/edge-config": "^1.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "aos": "^2.3.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.0.0",
    "date-fns-tz": "^3.0.0",
    "dompurify": "^3.0.0",
    "draco3d": "^1.5.7",
    "email-reply-parser": "^2.3.5",
    "imapflow": "^1.4.3",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mailparser": "^3.9.12",
    "marked": "^15.0.0",
    "meshoptimizer": "^1.2.0",
    "nanoid": "^5.0.0",
    "next": "^16.3.4",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.12.0",
    "puppeteer-core": "^25.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
